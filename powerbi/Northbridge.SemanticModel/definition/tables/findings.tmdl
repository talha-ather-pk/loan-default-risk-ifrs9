table findings
	lineageTag: 0b596068-953f-5c08-b9ea-e0d7f514a0fe

	column key
		dataType: string
		lineageTag: dc461b3c-3b49-5f98-9e50-d94988cf25c2
		summarizeBy: none
		sourceColumn: key

		annotation SummarizationSetBy = User

	column value
		dataType: double
		isHidden
		lineageTag: 7470593f-e674-5e6e-80ea-30b20de230d1
		summarizeBy: none
		sourceColumn: value

		annotation SummarizationSetBy = User

	column finding
		dataType: string
		lineageTag: 77c52f0b-24cb-5a02-81b5-471a900eadf6
		summarizeBy: none
		sourceColumn: finding

		annotation SummarizationSetBy = User

	partition findings = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "findings.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"key", "value", "finding"}),
				    Blanks = Table.TransformColumns(Kept, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"key", type text}, {"value", type number}, {"finding", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
