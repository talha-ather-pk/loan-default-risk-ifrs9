	partition fact_loan_month = m
		mode: import
		source =
				let
				    Source = Csv.Document(Binary.Decompress(File.Contents(DataFolder & "fact_loan_month.csv.gz"), Compression.GZip), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"loan_id", "month", "mob", "status", "days_past_due", "amount_paid", "balance_end", "charge_off_amount", "next_status", "status_order"}),
				    Blanks = Table.TransformColumns(Kept, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"loan_id", type text}, {"month", type text}, {"mob", Int64.Type}, {"status", type text}, {"days_past_due", Int64.Type}, {"amount_paid", type number}, {"balance_end", type number}, {"charge_off_amount", type number}, {"next_status", type text}, {"status_order", Int64.Type}}, "en-US"),
				    Ord_next_order = Table.AddColumn(Typed, "next_order", each if [next_status] = null then null else List.PositionOf({"Current", "30 DPD", "60 DPD", "90+ DPD", "Charged Off", "Prepaid", "Fully Paid"}, [next_status]) + 1, Int64.Type)
				in
				    Ord_next_order

	annotation PBI_ResultType = Table
