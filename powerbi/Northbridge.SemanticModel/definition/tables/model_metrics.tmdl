table model_metrics
	lineageTag: e7b5ec57-187e-58b9-9558-ad16a30930f2

	column model
		dataType: string
		lineageTag: dec38b3c-5d74-553b-b41d-f89bcd6b0afb
		summarizeBy: none
		sourceColumn: model

		annotation SummarizationSetBy = User

	column sample
		dataType: string
		lineageTag: c6b09d76-0d3a-5f78-8e50-fce773df37fa
		summarizeBy: none
		sourceColumn: sample

		annotation SummarizationSetBy = User

	column auc
		dataType: double
		isHidden
		lineageTag: d33cae9e-45d0-57e8-ab2e-79a29c22252b
		summarizeBy: none
		sourceColumn: auc

		annotation SummarizationSetBy = User

	column gini
		dataType: double
		isHidden
		lineageTag: 2ca94314-229a-534e-aa76-eb0d1d98c72b
		summarizeBy: none
		sourceColumn: gini

		annotation SummarizationSetBy = User

	column ks
		dataType: double
		isHidden
		lineageTag: e7b333ff-b8ac-5649-a341-8dd0ba68f3b9
		summarizeBy: none
		sourceColumn: ks

		annotation SummarizationSetBy = User

	partition model_metrics = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "model_metrics.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"model", "sample", "auc", "gini", "ks"}),
				    Blanks = Table.TransformColumns(Kept, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"model", type text}, {"sample", type text}, {"auc", type number}, {"gini", type number}, {"ks", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
