	partition dim_loan = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_loan.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"loan_id", "issue_date", "issue_month", "vintage_q", "vintage_year", "channel", "region", "loan_amnt", "term", "int_rate", "installment", "grade", "sub_grade", "purpose", "home_ownership", "verification_status", "emp_band", "fico_score", "fico_band", "dti", "dti_band", "annual_inc", "income_band", "score", "score_band", "score_range", "pd_24m", "status_now", "status_order", "months_observed", "months_available", "defaulted", "default_month", "default_mob", "default_12m", "default_24m", "charge_off_amount", "recoveries", "net_loss", "balance_now", "is_open", "policy_group", "stage_2025"}),
				    Blanks = Table.TransformColumns(Kept, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"loan_id", type text}, {"issue_date", type date}, {"issue_month", type text}, {"vintage_q", type text}, {"vintage_year", Int64.Type}, {"channel", type text}, {"region", type text}, {"loan_amnt", type number}, {"term", type text}, {"int_rate", type number}, {"installment", type number}, {"grade", type text}, {"sub_grade", type text}, {"purpose", type text}, {"home_ownership", type text}, {"verification_status", type text}, {"emp_band", type text}, {"fico_score", type number}, {"fico_band", type text}, {"dti", type number}, {"dti_band", type text}, {"annual_inc", type number}, {"income_band", type text}, {"score", Int64.Type}, {"score_band", Int64.Type}, {"score_range", type text}, {"pd_24m", type number}, {"status_now", type text}, {"status_order", Int64.Type}, {"months_observed", Int64.Type}, {"months_available", Int64.Type}, {"defaulted", Int64.Type}, {"default_month", type text}, {"default_mob", Int64.Type}, {"default_12m", type number}, {"default_24m", type number}, {"charge_off_amount", type number}, {"recoveries", type number}, {"net_loss", type number}, {"balance_now", type number}, {"is_open", Int64.Type}, {"policy_group", type text}, {"stage_2025", type text}}, "en-US"),
				    Ord_emp_order = Table.AddColumn(Typed, "emp_order", each if [emp_band] = null then null else List.PositionOf({"< 1 year", "1-4 years", "5-9 years", "10+ years", "Unknown"}, [emp_band]) + 1, Int64.Type),
				    Ord_income_order = Table.AddColumn(Ord_emp_order, "income_order", each if [income_band] = null then null else List.PositionOf({"< $40k", "$40-60k", "$60-80k", "$80-120k", "$120k+", "Missing"}, [income_band]) + 1, Int64.Type),
				    Ord_policy_order = Table.AddColumn(Ord_income_order, "policy_order", each if [policy_group] = null then null else List.PositionOf({"Before · DTI ≤ 40%", "After · DTI ≤ 40%", "After · DTI 40-50% (new)"}, [policy_group]) + 1, Int64.Type)
				in
				    Ord_policy_order

	annotation PBI_ResultType = Table
