	measure 'Roll Rate' = IF ( SELECTEDVALUE ( fact_loan_month[status] ) IN { "Current", "30 DPD", "60 DPD" } && NOT ISBLANK ( SELECTEDVALUE ( fact_loan_month[next_status] ) ), DIVIDE ( COUNTROWS ( fact_loan_month ), CALCULATE ( COUNTROWS ( fact_loan_month ), REMOVEFILTERS ( fact_loan_month[next_status], fact_loan_month[next_order] ), NOT ISBLANK ( fact_loan_month[next_status] ) ) ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 3 Vintages
		lineageTag: 942031c9-b4a4-52d5-a6a2-cba0512b30e6

	measure 'Roll 30 to 60' = CALCULATE ( DIVIDE ( CALCULATE ( COUNTROWS ( fact_loan_month ), fact_loan_month[next_status] = "60 DPD" ), CALCULATE ( COUNTROWS ( fact_loan_month ), NOT ISBLANK ( fact_loan_month[next_status] ) ) ), fact_loan_month[status] = "30 DPD" )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 3 Vintages
		lineageTag: a1dae64d-809c-5e63-b278-525793bd8a60

	measure 'Roll 60 to 90' = CALCULATE ( DIVIDE ( CALCULATE ( COUNTROWS ( fact_loan_month ), fact_loan_month[next_status] = "90+ DPD" ), CALCULATE ( COUNTROWS ( fact_loan_month ), NOT ISBLANK ( fact_loan_month[next_status] ) ) ), fact_loan_month[status] = "60 DPD" )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 3 Vintages
		lineageTag: e9fd6531-7e5f-5bb3-8917-67b244e143bd

	measure 'Cure from 30' = CALCULATE ( DIVIDE ( CALCULATE ( COUNTROWS ( fact_loan_month ), fact_loan_month[next_status] = "Current" ), CALCULATE ( COUNTROWS ( fact_loan_month ), NOT ISBLANK ( fact_loan_month[next_status] ) ) ), fact_loan_month[status] = "30 DPD" )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 3 Vintages
		lineageTag: 898f6d4e-ef2c-5296-9d13-2023505bf396

	measure 'Roll Current to 30' = CALCULATE ( DIVIDE ( CALCULATE ( COUNTROWS ( fact_loan_month ), fact_loan_month[next_status] = "30 DPD" ), CALCULATE ( COUNTROWS ( fact_loan_month ), NOT ISBLANK ( fact_loan_month[next_status] ) ) ), fact_loan_month[status] = "Current" )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 3 Vintages
		lineageTag: f1fd18c7-8a25-5727-93aa-7bfca3d1a097

	measure 'Unemployment Sensitivity' = EXP ( CALCULATE ( MAX ( findings[value] ), findings[key] = "unemployment_beta" ) ) - 1
