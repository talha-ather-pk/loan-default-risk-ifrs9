	measure 'Cum Default Rate' = VAR m = MAX ( dim_mob[mob] ) VAR avail = MIN ( dim_loan[months_available] ) RETURN IF ( m > avail, BLANK (), DIVIDE ( CALCULATE ( COUNTROWS ( dim_loan ), NOT ISBLANK ( dim_loan[default_mob] ), dim_loan[default_mob] <= m ), [Loans] ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 3 Vintages
		lineageTag: 16a09cc3-95b4-571d-8fba-fe01892dec59

	measure 'Vintage 2023 at 24m' = CALCULATE ( MAX ( findings[value] ), findings[key] = "vintage_2023_24m" )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 3 Vintages
		lineageTag: 5403e6c7-e3da-5743-8623-166c7e1dfe60

	measure 'Vintage 2021 at 24m' = CALCULATE ( MAX ( findings[value] ), findings[key] = "vintage_2021_24m" )
