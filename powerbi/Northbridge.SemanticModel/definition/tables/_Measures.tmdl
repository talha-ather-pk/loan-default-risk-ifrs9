table _Measures
	lineageTag: cd041ea2-4647-5500-b24d-0c06a0c92d4e

	measure Loans = COUNTROWS ( dim_loan )
		formatString: #,0
		displayFolder: 1 Portfolio
		lineageTag: 8549214a-1ad1-5c8c-a998-88a63281c868

	measure 'Amount Lent' = SUM ( dim_loan[loan_amnt] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 1 Portfolio
		lineageTag: 7feb905b-e013-511f-a78d-0133226c463e

	measure 'Avg Loan' = DIVIDE ( [Amount Lent], [Loans] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 1 Portfolio
		lineageTag: 7f278cb0-ced8-5699-94a0-b4649362e343

	measure 'Avg Rate' = DIVIDE ( SUMX ( dim_loan, dim_loan[int_rate] * dim_loan[loan_amnt] ), [Amount Lent] ) / 100
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 1 Portfolio
		lineageTag: 48b9b430-e703-569e-b1a1-2776a92cc7c3

	measure Defaults = SUM ( dim_loan[defaulted] )
		formatString: #,0
		displayFolder: 1 Portfolio
		lineageTag: 7446a64a-2d1c-5b70-828b-5d08aa2b521a

	measure 'Default Rate 24m' = DIVIDE ( SUM ( dim_loan[default_24m] ), COUNT ( dim_loan[default_24m] ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 1 Portfolio
		lineageTag: 3bb08367-64c2-5e08-8030-deae8dd61823

	measure 'Default Rate 12m' = DIVIDE ( SUM ( dim_loan[default_12m] ), COUNT ( dim_loan[default_12m] ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 1 Portfolio
		lineageTag: 9f2a3eb6-e4fb-52e5-aa8b-3543287043d9

	measure 'Charged Off' = SUM ( dim_loan[charge_off_amount] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 1 Portfolio
		lineageTag: 86ede371-1520-5c07-962a-dc00ba19f5c2

	measure Recovered = SUM ( dim_loan[recoveries] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 1 Portfolio
		lineageTag: b48714e1-4a8b-5aab-9d56-bfd76adf6535

	measure 'Net Loss' = [Charged Off] - [Recovered]
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 1 Portfolio
		lineageTag: f5ee3720-abf7-5698-aaee-d705e168d4a2

	measure 'Net Loss Rate' = DIVIDE ( [Net Loss], [Amount Lent] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 1 Portfolio
		lineageTag: b447fb52-946c-5b38-9f4a-701b42ec115c

	measure 'Recovery Rate' = DIVIDE ( [Recovered], [Charged Off] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 1 Portfolio
		lineageTag: 42b553a4-9339-5581-a6fb-2465900a0109

	measure 'Book Balance' = CALCULATE ( SUM ( fact_loan_month[balance_end] ), KEEPFILTERS ( fact_loan_month[status] IN { "Current", "30 DPD", "60 DPD", "90+ DPD" } ) )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 1 Portfolio
