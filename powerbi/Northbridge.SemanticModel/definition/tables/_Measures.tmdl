	measure 'Open Balance' = CALCULATE ( [Book Balance], fact_loan_month[month] = "2025-12" )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 1 Portfolio
		lineageTag: fae2abd6-bb01-530c-a364-af7cec567f8b

	measure 'Open Loans' = CALCULATE ( COUNTROWS ( fact_loan_month ), fact_loan_month[month] = "2025-12", fact_loan_month[status] IN { "Current", "30 DPD", "60 DPD", "90+ DPD" } )
		formatString: #,0
		displayFolder: 1 Portfolio
		lineageTag: 6f427871-0dbb-59d4-a521-0eac4de4c4ee

	measure 'Arrears Balance' = CALCULATE ( [Book Balance], KEEPFILTERS ( fact_loan_month[status] IN { "30 DPD", "60 DPD", "90+ DPD" } ) )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 1 Portfolio
		lineageTag: 880ed57f-cc30-5799-b6d1-d0eea2c40e3d

	measure 'Arrears Share' = DIVIDE ( [Arrears Balance], [Book Balance] )
