	measure 'Roll Heat' = VAR r = [Roll Rate] RETURN SWITCH ( TRUE (), ISBLANK ( r ), BLANK (), r > 0.6, "#1F4E79", r > 0.3, "#4F7BA6", r > 0.1, "#8FB0CF", r > 0.01, "#C9D8E8", "#F3F6FA" )
		isHidden
