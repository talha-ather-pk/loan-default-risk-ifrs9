	measure 'FICO Multiple' = DIVIDE ( CALCULATE ( [Default Rate 24m], dim_loan[fico_band] = "620-659" ), CALCULATE ( [Default Rate 24m], dim_loan[fico_band] = "780+" ) )
		formatString: 0.0"x"
		displayFolder: 2 Risk
		lineageTag: 85744750-36d4-5643-8c2c-437e395dece9

	measure 'Riskiest Purpose' = VAR t = ADDCOLUMNS ( VALUES ( dim_loan[purpose] ), "@v", [Default Rate 24m] ) RETURN MAXX ( TOPN ( 1, t, [@v], DESC ), dim_loan[purpose] )
		displayFolder: 2 Risk
		lineageTag: c3bb6934-96c5-53f9-8e4c-88722b2952f1

	measure 'Riskiest Purpose Rate' = MAXX ( VALUES ( dim_loan[purpose] ), [Default Rate 24m] )
