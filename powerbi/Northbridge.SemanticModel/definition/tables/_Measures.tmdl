		displayFolder: 1 Portfolio
		lineageTag: 3dab1328-3def-5420-abed-b5149bb6f97a

	measure 'New Defaults' = CALCULATE ( COUNTROWS ( fact_loan_month ), fact_loan_month[status] = "90+ DPD", fact_loan_month[days_past_due] = 90 )
		formatString: #,0
		displayFolder: 1 Portfolio
