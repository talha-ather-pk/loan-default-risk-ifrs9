table fact_recovery
	lineageTag: 69159a92-e3db-502d-9ace-6de4840e0e63

	column loan_id
		dataType: string
		isHidden
		lineageTag: f55f87f7-d86f-5743-88b5-396ddb2cc31a
		summarizeBy: none
		sourceColumn: loan_id

		annotation SummarizationSetBy = User

	column month
		dataType: string
		isHidden
		lineageTag: a70dec92-294b-5d9a-a3c1-3f999460b150
		summarizeBy: none
		sourceColumn: month

		annotation SummarizationSetBy = User

	column recovery_amount
		dataType: double
		isHidden
		lineageTag: 4655ed65-a15b-55c4-acf4-9c35c6a6dda0
		summarizeBy: none
		sourceColumn: recovery_amount

		annotation SummarizationSetBy = User

	partition fact_recovery = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_recovery.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"loan_id", "month", "recovery_amount"}),
				    Blanks = Table.TransformColumns(Kept, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"loan_id", type text}, {"month", type text}, {"recovery_amount", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
