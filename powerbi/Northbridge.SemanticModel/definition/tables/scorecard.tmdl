	partition scorecard = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "scorecard.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
