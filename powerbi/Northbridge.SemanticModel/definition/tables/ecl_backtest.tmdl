	partition ecl_backtest = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "ecl_backtest.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"score_band", "loans", "predicted_base", "predicted_weighted", "predicted_actual_unemployment", "actual"}),
				    Blanks = Table.TransformColumns(Kept, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"score_band", Int64.Type}, {"loans", Int64.Type}, {"predicted_base", type number}, {"predicted_weighted", type number}, {"predicted_actual_unemployment", type number}, {"actual", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
