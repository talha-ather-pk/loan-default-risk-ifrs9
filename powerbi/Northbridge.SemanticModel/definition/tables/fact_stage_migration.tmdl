				    Kept = Table.SelectColumns(Promoted, {"stage_2024", "to_state", "loans", "ead_2024", "to_order"}),
				    Blanks = Table.TransformColumns(Kept, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"stage_2024", type text}, {"to_state", type text}, {"loans", Int64.Type}, {"ead_2024", type number}, {"to_order", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
