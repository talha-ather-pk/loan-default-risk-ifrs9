	partition fact_stage_migration = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_stage_migration.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
