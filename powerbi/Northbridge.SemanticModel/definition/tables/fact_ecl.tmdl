	partition fact_ecl = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_ecl.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"asof", "loan_id", "stage", "mob", "ead", "lgd", "pd12", "pd_life", "ecl", "ecl_Base", "ecl_Upside", "ecl_Downside", "asof_label"}),
				    Blanks = Table.TransformColumns(Kept, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"asof", type text}, {"loan_id", type text}, {"stage", type text}, {"mob", Int64.Type}, {"ead", type number}, {"lgd", type number}, {"pd12", type number}, {"pd_life", type number}, {"ecl", type number}, {"ecl_Base", type number}, {"ecl_Upside", type number}, {"ecl_Downside", type number}, {"asof_label", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
